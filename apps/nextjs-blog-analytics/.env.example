# The Prompting Company Configuration
# Get these values from https://app.promptingco.com

# Server-side API key (organization-scoped recommended)
# This key will be passed as organizationAPIKey to the SDK
TPC_API_KEY=tpc_sk_your_api_key_here

# Your organization slug (from your organization URL)
TPC_ORG_SLUG=your-organization-slug

# The product slug you want to track analytics for
TPC_PRODUCT_SLUG=your-product-slug

