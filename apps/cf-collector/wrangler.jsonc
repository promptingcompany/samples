{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tpc-collector",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-20",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "example.com/*",
			"zone_name": "example.com",
		}
	],
	"vars": {
		"TPC_API_URL": "https://app.promptingco.com/api/v1/analytics/events"
	}
}
